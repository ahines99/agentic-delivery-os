# Reference only: the application does not automatically load this file.
# Runtime settings live in config.local.json or the path selected below.
# scripts/configure_local.py creates ignored operator/Compose credentials.
# Never put real credentials in tickets, prompts, fixtures, or committed files.
DELIVERY_CONFIG=config.local.json

# Only the authorized worker needs its configured model API-key environment variable.
# Model/provider/rate-card/budget settings belong in the JSON configuration.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Live provider onboarding is incomplete; publication_enabled remains false in JSON.
# GitHub App IDs are JSON fields, not automatically read from environment variables.
# The private key is PEM content in the variable named by github_private_key_env.
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# LINEAR_WEBHOOK_SECRET=
# LINEAR_API_KEY=

# Opt-in integration tests require disposable services and a pinned local image ID.
# TEST_DATABASE_URL=postgresql+psycopg://delivery:REPLACE_PASSWORD@127.0.0.1:25432/delivery
# TEST_TEMPORAL_ADDRESS=127.0.0.1:27233
# TEST_SANDBOX_IMAGE=sha256:REPLACE_WITH_INSPECTED_IMAGE_ID
